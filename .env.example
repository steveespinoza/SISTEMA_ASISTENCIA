# Credenciales de desarrollo para la base definida en compose.yaml.
DATABASE_URL=postgresql+psycopg://asistencia:asistencia_local@127.0.0.1:5432/asistencia

# Genera una clave local aleatoria y pégala en .env.
FLASK_SECRET_KEY=
# Permite usar la cookie en HTTP durante el desarrollo local.
SESSION_COOKIE_SECURE=0
COMPANY_TIMEZONE=America/Lima
